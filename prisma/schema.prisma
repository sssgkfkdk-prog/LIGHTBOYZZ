generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("lightboyz_PRISMA_DATABASE_URL")
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  imageUrl    String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  channel   String
  text      String
  avatarUrl String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
}
